---
// 星露谷物语主题 404 页：在矿洞里晕倒，被刘易斯送回家
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>404 · 你在矿洞里晕倒了</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html,
      body {
        height: 100%;
      }

      body {
        font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;
        background:
          radial-gradient(ellipse at 50% -20%, #1c2233 0%, transparent 60%),
          linear-gradient(180deg, #10131f 0%, #0a0c14 100%);
        color: #e8e2d0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        overflow: hidden;
        position: relative;
      }

      /* 洞顶垂落的星光尘埃 */
      .stars {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .star {
        position: absolute;
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: #f5d76e;
        opacity: 0.35;
        animation: twinkle 3.2s ease-in-out infinite;
      }

      @keyframes twinkle {
        0%, 100% { opacity: 0.12; transform: scale(0.8); }
        50% { opacity: 0.65; transform: scale(1.15); }
      }

      /* 眩晕的小星星 */
      .dizzy {
        position: absolute;
        top: 12%;
        left: 50%;
        font-size: 1.6rem;
        animation: spinWobble 2.4s ease-in-out infinite;
        filter: drop-shadow(0 0 8px rgba(245, 215, 110, 0.6));
      }

      @keyframes spinWobble {
        0%, 100% { transform: translateX(-70px) rotate(-20deg); }
        25% { transform: translateX(0) translateY(-10px) rotate(10deg); }
        50% { transform: translateX(70px) rotate(20deg); }
        75% { transform: translateX(0) translateY(6px) rotate(-10deg); }
      }

      .panel {
        position: relative;
        z-index: 2;
        width: min(560px, calc(100vw - 2.5rem));
        background: linear-gradient(180deg, #2b2036 0%, #241a2e 100%);
        border: 4px solid #8a5a3b;
        border-radius: 10px;
        box-shadow:
          inset 0 0 0 3px #5d3a24,
          0 0 0 6px rgba(0, 0, 0, 0.35),
          0 24px 60px rgba(0, 0, 0, 0.6);
        padding: 2.2rem 2rem 2rem;
        text-align: center;
        animation: panelIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      @keyframes panelIn {
        from { opacity: 0; transform: translateY(28px) scale(0.96); }
        to { opacity: 1; transform: translateY(0) scale(1); }
      }

      .skull {
        font-size: 3.4rem;
        line-height: 1;
        display: inline-block;
        animation: bob 2s ease-in-out infinite;
      }

      @keyframes bob {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
      }

      .title {
        margin-top: 0.9rem;
        font-size: 1.7rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        color: #ffd968;
        text-shadow: 0 2px 0 #7a5416, 0 4px 10px rgba(0, 0, 0, 0.5);
      }

      .lines {
        margin-top: 1.1rem;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
      }

      .line {
        font-size: 0.98rem;
        line-height: 1.7;
        color: #d8cfba;
        opacity: 0;
        animation: lineIn 0.55s ease-out forwards;
      }

      .line:nth-child(1) { animation-delay: 0.55s; }
      .line:nth-child(2) { animation-delay: 1.35s; }
      .line:nth-child(3) { animation-delay: 2.15s; }

      .line .gold {
        color: #ffd968;
        font-weight: 700;
      }

      @keyframes lineIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .buttons {
        margin-top: 1.6rem;
        display: flex;
        gap: 0.8rem;
        justify-content: center;
        flex-wrap: wrap;
        opacity: 0;
        animation: lineIn 0.55s ease-out 2.7s forwards;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.72rem 1.5rem;
        border-radius: 8px;
        font-size: 0.98rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-decoration: none;
        cursor: pointer;
        border: none;
        transition: transform 0.15s ease, filter 0.15s ease;
      }

      .btn:hover { transform: translateY(-2px); filter: brightness(1.1); }
      .btn:active { transform: translateY(0); filter: brightness(0.95); }

      .btn-primary {
        background: linear-gradient(180deg, #f0a83c 0%, #d9821f 100%);
        color: #3d2405;
        box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.35), 0 4px 12px rgba(0, 0, 0, 0.45);
      }

      .btn-ghost {
        background: rgba(255, 255, 255, 0.08);
        color: #e8e2d0;
        border: 2px solid rgba(232, 226, 208, 0.35);
      }

      .hint {
        position: relative;
        z-index: 2;
        margin-top: 1.4rem;
        font-size: 0.8rem;
        color: rgba(216, 207, 186, 0.45);
        opacity: 0;
        animation: lineIn 0.6s ease-out 3.1s forwards;
      }

      .zzz {
        position: absolute;
        top: 18%;
        right: 12%;
        font-size: 1.3rem;
        color: rgba(245, 215, 110, 0.55);
        animation: floatZzz 3s ease-in-out infinite;
      }

      .zzz.z2 { right: auto; left: 14%; top: 24%; font-size: 1rem; animation-delay: 1.2s; }

      @keyframes floatZzz {
        0% { opacity: 0; transform: translateY(6px); }
        40% { opacity: 1; }
        100% { opacity: 0; transform: translateY(-22px); }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition: none !important;
        }
        .line, .buttons, .hint { opacity: 1; }
      }
    </style>
  </head>
  <body>
    <div class="stars" aria-hidden="true"></div>
    <div class="dizzy" aria-hidden="true">✦ ✧ ✦</div>
    <div class="zzz" aria-hidden="true">Z</div>
    <div class="zzz z2" aria-hidden="true">z</div>

    <main class="panel">
      <span class="skull" aria-hidden="true">😵</span>
      <h1 class="title">你在矿洞里晕倒了！</h1>
      <div class="lines">
        <p class="line">这里不是鹈鹕镇，你好像迷路了……</p>
        <p class="line">刘易斯镇长把你抬回了家，还顺手拿走了 <span class="gold">500g</span></p>
        <p class="line">医生说：页面不存在，但体力可以慢慢回。</p>
      </div>
      <div class="buttons">
        <a class="btn btn-primary" href="/">🏠 返回农场</a>
        <button class="btn btn-ghost" type="button" onclick="window.location.reload()">⛏️ 再挖一次</button>
      </div>
    </main>

    <p class="hint">小提示：按 F5 可以重新进入矿洞（并没有这种设定）</p>

    <script is:inline>
      // 随机生成洞顶星光
      (function () {
        var wrap = document.querySelector(".stars");
        if (!wrap) return;
        for (var i = 0; i < 40; i++) {
          var s = document.createElement("span");
          s.className = "star";
          s.style.left = Math.random() * 100 + "%";
          s.style.top = Math.random() * 100 + "%";
          s.style.animationDelay = (Math.random() * 3).toFixed(2) + "s";
          var scale = 0.6 + Math.random() * 0.9;
          s.style.transform = "scale(" + scale + ")";
          wrap.appendChild(s);
        }
      })();
    </script>
  </body>
</html>
